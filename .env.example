# Pain Miner — Environment Variables Template
# Copy to .env and fill in real values.

# Grok discovery (xAI)
XAI_API_KEY=xai-...
XAI_MODEL=grok-4-1-fast-reasoning

# Supabase — service role (server-side inserts) + anon key (frontend reads)
# Create a dedicated Pain Miner Supabase project, then run schema/pain_miner.sql.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=eyJ...    # service_role — Settings → API → service_role
SUPABASE_ANON_KEY=eyJ... # anon public — Settings → API → anon public

# RPC secret — generate with: openssl rand -hex 32
# Must match the value seeded into pain_miner_secrets:
#   INSERT INTO pain_miner_secrets (key, value) VALUES ('rpc_shared_secret', '<value>');
PAINMINER_RPC_SECRET=

# nginx htpasswd login credentials (managed by deploy/painminer-deploy.sh)
PAINMINER_USER=painminer
PAINMINER_PASS=

# Brevo transactional email (300/day free tier)
BREVO_API_KEY=
EMAIL_FROM="Pain Miner <research@mg.muisbien.com>"

# Stack Exchange API key — 10k req/day (register at stackapps.com)
STACK_EXCHANGE_KEY=
